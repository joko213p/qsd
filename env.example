# ── Obligatoire ───────────────────────────────────────────────
BOT_TOKEN=123456:ABC-DEF_token_de_BotFather

# ── Connexion Instagram (recommandé) ──────────────────────────
# Généré en local avec make_cookies.py. Indispensable pour les
# stories, la section "à la une", et les comptes privés que tu suis.
IG_COOKIES_B64=

# ── Proxy Webshare (recommandé) ───────────────────────────────
# ⚠️ Utilise BIEN le nom "PROXY" (et PAS HTTP_PROXY/HTTPS_PROXY,
#    sinon le trafic Telegram passerait aussi par le proxy).
# Format Webshare rotatif :  http://USER-rotate:PASS@p.webshare.io:80
# Format Webshare fixe     :  http://USER:PASS@IP:PORT
PROXY=

# ── Optionnel ─────────────────────────────────────────────────
# Restreindre l'usage du bot à certains IDs Telegram (séparés par des virgules)
ALLOWED_USER_IDS=
# Envoyer les fichiers dans un groupe précis plutôt qu'en privé
GROUP_ID=
# Nombre maximum de publications/reels téléchargées par profil
MAX_POSTS=30
